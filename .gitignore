# Environment variables
*.env

# Virtual environments
*env/
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# ADK and generated output
**/.adk/

# OS files
.DS_Store

# Local exploration / debug residue — not part of the production import path
scratch/

# MoE-F coordinator runtime artefacts (regenerated on each run)
model_library/agentic_ai/moe_coordinator/moe_history.csv
model_library/agentic_ai/moe_coordinator/moe_regimes.png

# ── QuantConnect LEAN Engine ──────────────────────────────────────────────────
# lean_workspace/ is a LEAN CLI runtime root — it contains downloaded market data
# (can be many GB), Docker layer caches, and synced project copies.
# Source of truth for strategy code stays in lean_engine/lean_project/.
strategy_testing/lean_engine/lean_workspace/*
!strategy_testing/lean_engine/lean_workspace/lean.json

# Backtest result artefacts (HTML reports, JSON stats) written alongside source
strategy_testing/lean_engine/backtests/

# LEAN engine object store / storage cache
storage/

# LEAN credentials and Docker layer cache (stored in home dir by default)
.lean/

# Root-level lean.json (legacy artefact from running `lean init` at repo root)
/lean.json

*block_convey*
